# ==========================================
# Environment Configuration
# ==========================================

# Environment: development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==========================================
# Database Connections
# ==========================================

# Primary Data Warehouse (Snowflake example)
# SNOWFLAKE_ACCOUNT=your_account
# SNOWFLAKE_USER=your_user
# SNOWFLAKE_PASSWORD=your_password
# SNOWFLAKE_DATABASE=ANALYTICS
# SNOWFLAKE_SCHEMA=PROD
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_ROLE=SYSADMIN

# Local SQLite for development
SQLITE_PATH=data/warehouse.db

# Postgres (used by Airflow metadata & local warehouse)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=changeme
POSTGRES_DB=warehouse

# ==========================================
# Data Sources
# ==========================================

# ERP System (simulated file path)
ERP_DATA_PATH=data/sources/erp

# CRM API (simulated endpoint)
CRM_API_BASE_URL=https://api.crm.example.com/v1
CRM_API_KEY=your_api_key_here

# IoT Kafka (simulated broker)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_IOT_TOPIC=iot.sensor.data

# ==========================================
# Pipeline Configuration
# ==========================================

# Batch processing
BATCH_SIZE=100000
MAX_WORKERS=4

# Schema evolution
ENABLE_SCHEMA_EVOLUTION=true
SCHEMA_REGISTRY_URL=http://localhost:8081

# Data quality
ENABLE_QUALITY_CHECKS=true
QUALITY_THRESHOLD=0.95

# Lineage
ENABLE_LINEAGE_TRACKING=true
LINEAGE_BACKEND=sqlite
